# Caddy and frontend
DOMAIN=example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
ORIGIN=https://${DOMAIN}

# Backend and PostgreSQL
# Keep passwords URL-safe because Compose uses them in PostgreSQL connection URLs.
BACKEND_PORT=8080
POPISOMATOR_JWT_SECRET=replace-with-a-strong-random-secret
POSTGRES_ADMIN_USER=popisomator_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-secret
POSTGRES_DB=popisomator
POSTGRES_APP_USER=popisomator
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-secret
