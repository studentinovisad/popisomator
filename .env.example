# PostgreSQL for local testing
# Keep passwords URL-safe because they are used in PostgreSQL connection URLs.
POSTGRES_ADMIN_USER=popisomator_admin
POSTGRES_ADMIN_PASSWORD=popisomator_admin
POSTGRES_DB=popisomator
POSTGRES_PORT=5432

# Application database role
POSTGRES_APP_USER=popisomator
POSTGRES_APP_PASSWORD=popisomator

# Database connections
POPISOMATOR_MIGRATION_DSN="postgres://${POSTGRES_ADMIN_USER}:${POSTGRES_ADMIN_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
POPISOMATOR_POSTGRES_DSN="postgres://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"

# Local backend port
BACKEND_PORT=8080
POPISOMATOR_JWT_SECRET=dev-only-jwt-secret-change-me

# Frontend development proxy
POPISOMATOR_BACKEND_URL=http://localhost:${BACKEND_PORT}
