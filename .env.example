# PostgreSQL for local testing
POSTGRES_USER=popisomator
POSTGRES_PASSWORD=popisomator
POSTGRES_DB=popisomator
POSTGRES_PORT=5432
POPISOMATOR_POSTGRES_DSN="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"

# Local backend port
BACKEND_PORT=8080

# Frontend development proxy
POPISOMATOR_BACKEND_URL=http://localhost:${BACKEND_PORT}
